{
  "name": "skill-board",
  "productName": "Skill Board",
  "version": "0.1.0",
  "description": "本机 AI skill 使用排行榜",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --dir"
  },
  "build": {
    "appId": "local.skillboard",
    "productName": "Skill Board",
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "package.json"
    ]
  },
  "dependencies": {
    "js-yaml": "^5.5.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "license": "MIT"
}
